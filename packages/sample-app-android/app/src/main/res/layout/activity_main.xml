<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="PromptSurge Sample"
        android:textAppearance="?attr/textAppearanceHeadlineSmall" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:text="Tap the button to trigger the pre-prompt."
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnTriggerPrePrompt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Trigger Pre-Prompt" />

    <!-- Debug-only: shown/hidden in code via BuildConfig.DEBUG -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnResetRateLimit"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Reset Rate Limit (debug)"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOverrideLocale"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Override Locale (debug)"
        android:visibility="gone" />

</LinearLayout>
