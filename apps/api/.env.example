# Copy to .env and fill in real values. Never commit .env.

# Supabase direct connection string (Project Settings → Database → Connection string → URI)
# URL-encode any special characters in the password (e.g. @ → %40, # → %23)
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# API port (3000 locally, 8080 inside the Docker/Fly image)
PORT=3000

# "development" | "production" | "test"
NODE_ENV=development

# Allowed CORS origin for the admin panel.
# Leave unset in local dev (defaults to allow-all).
# In production set to: https://admin.promptsurge.me
# ADMIN_ORIGIN=https://admin.promptsurge.me
