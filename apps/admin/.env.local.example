# Copy to .env.local for local dev. Never commit .env.local.

# URL the browser uses to reach the API (client-side fetch from browser)
NEXT_PUBLIC_API_URL=http://localhost:3000

# URL Next.js server-side rendering uses to reach the API.
# In production on Vercel this should equal NEXT_PUBLIC_API_URL (public URL).
PROMPTSURGE_API_URL=http://localhost:3000
